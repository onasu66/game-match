{
  "name": "game-match-api",
  "version": "1.0.0",
  "private": true,
  "description": "Match listing API for game voice MVP (Cloudflare Worker + D1, local Node fallback)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/local-server.ts",
    "start": "tsx src/local-server.ts",
    "db:init": "tsx src/init-local-db.ts",
    "cf:dev": "wrangler dev",
    "cf:deploy": "wrangler deploy",
    "cf:db:local": "wrangler d1 execute game-match-db --local --file=./schema.sql",
    "test:smoke": "tsx src/smoke-test.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.0",
    "bcryptjs": "^3.0.2",
    "better-sqlite3": "^11.10.0",
    "hono": "^4.9.0",
    "jose": "^6.0.11",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20251120.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/better-sqlite3": "^7.6.13",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "wrangler": "^4.45.0"
  }
}
